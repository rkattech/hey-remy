---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Page not found · Remy" description="That page does not exist on hey-remy.com.">
  <SiteNav />
  <main class="mx-auto max-w-2xl px-6 py-24 text-center sm:py-32">
    <p class="text-xs font-bold uppercase tracking-[0.06em] text-[var(--muted)]">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">That page isn't here.</h1>
    <p class="mt-4 text-[17px] text-[var(--ink-2)]">
      Try the <a class="underline underline-offset-4" href="/">home page</a>, the
      <a class="underline underline-offset-4" href="/blog">blog</a>, or the
      <a class="underline underline-offset-4" href="/faq">FAQ</a>.
    </p>
  </main>
  <SiteFooter />
</Layout>
